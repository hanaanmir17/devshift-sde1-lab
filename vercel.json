{
  "version": 2,
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Permissions-Policy","value":"camera=(), geolocation=()"},
      {"key":"Cross-Origin-Opener-Policy","value":"same-origin"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self' 'unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"}
    ]},
    {"source":"/runner-worker.js","headers":[{"key":"Content-Security-Policy","value":"default-src 'none'; script-src 'unsafe-eval'; connect-src 'none'"}]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]}
  ]
}
